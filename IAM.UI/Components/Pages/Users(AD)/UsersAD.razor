@page "/usersAD"
@rendermode InteractiveServer

@using IAM.UI.Services
@using IAM.UI.DTOs

@inject ApiService Api
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h3 class="mb-1">Active Directory Users</h3>
        <div class="text-muted small">
            Users loaded directly from Active Directory
        </div>
    </div>

    <button class="btn btn-outline-primary" @onclick="GoToLocalUsers">
        Local DB Users
    </button>

</div>

<!-- SEARCH -->
<div class="card p-3 mb-4">

    <div class="d-flex gap-2">

        <input class="form-control" placeholder="Search by username, display name, email, or DN..." @bind="searchText"
               @bind:event="oninput" />

        <button class="btn btn-primary" @onclick="Search">
            Search
        </button>

        <button class="btn btn-secondary" @onclick="Reset">
            Reset
        </button>

    </div>

</div>

@if (!loaded)
{
    <div class="card p-3">
        Loading Active Directory users...
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="card p-3 text-danger">
        @errorMessage
    </div>
}
else if (!DisplayUsers.Any())
{
    <div class="card p-3">
        No Active Directory users found
    </div>
}
else
{
    <div class="row g-3">

        @foreach (var user in DisplayUsers)
        {
            <div class="col-md-4">
                <div class="app-card" @onclick="() => OpenADProfile(user.SamAccountName)">

                    <div class="d-flex justify-content-between align-items-start mb-2">

                        <div class="app-card-title">
                            👤 @(string.IsNullOrWhiteSpace(user.DisplayName)
                                            ? user.SamAccountName
                                            : user.DisplayName)
                        </div>

                        @if (user.Enabled)
                        {
                            <span class="app-badge app-badge-blue">
                                🟢 Enabled
                            </span>
                        }
                        else
                        {
                            <span class="app-badge app-badge-gray">
                                🔴 Disabled
                            </span>
                        }

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-2">

                        <span class="app-badge app-badge-dark">
                            SAM: @user.SamAccountName
                        </span>

                        @if (!string.IsNullOrWhiteSpace(user.Email))
                        {
                            <span class="app-badge app-badge-blue">
                                ✉️ @user.Email
                            </span>
                        }

                    </div>

                    <div class="text-muted small mt-3">
                        @user.DistinguishedName
                    </div>

                </div>

            </div>
        }

    </div>

    @if (!isSearching)
    {
        <div class="mt-4 d-flex justify-content-center gap-3">

            <button class="btn btn-outline-primary btn-sm" @onclick="PrevPage" disabled="@IsFirstPage">
                ◀
            </button>

            <span>Page @CurrentPage of @TotalPages</span>

            <button class="btn btn-outline-primary btn-sm" @onclick="NextPage" disabled="@IsLastPage">
                ▶
            </button>

        </div>
    }
}

@code {

    List<ADUserDto> users = new();
    List<ADUserDto> searchResult = new();

    string searchText = "";
    string? errorMessage;

    bool isSearching = false;
    bool loaded = false;

    const int PageSize = 15;
    int CurrentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadADUsers();
    }

    async Task LoadADUsers()
    {
        loaded = false;
        errorMessage = null;

        var res = await Api.GetAsync("ad/users");

        if (res.IsSuccessStatusCode)
        {
            var result =
                await res.Content.ReadFromJsonAsync<ApiResponseDTO<List<ADUserDto>>>();

            users = result?.Data ?? new();
        }
        else
        {
            errorMessage = await res.Content.ReadAsStringAsync();
        }

        loaded = true;
    }

    void OpenADProfile(string samAccountName)
    {
        Nav.NavigateTo($"/usersAD/{samAccountName}");
    }

    void GoToLocalUsers()
    {
        Nav.NavigateTo("/users");
    }

    void Search()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return;

        isSearching = true;
        CurrentPage = 1;

        var text = searchText.Trim();

        searchResult = users
            .Where(u =>
                u.SamAccountName.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                u.DisplayName.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                u.DistinguishedName.Contains(text, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    void Reset()
    {
        searchText = "";
        isSearching = false;
        searchResult.Clear();
        CurrentPage = 1;
    }

    IEnumerable<ADUserDto> DisplayUsers =>
        isSearching ? searchResult : PagedUsers;

    IEnumerable<ADUserDto> PagedUsers =>
        users.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(users.Count / (double)PageSize));

    bool IsFirstPage => CurrentPage == 1;
    bool IsLastPage => CurrentPage >= TotalPages;

    void NextPage()
    {
        if (!IsLastPage)
            CurrentPage++;
    }

    void PrevPage()
    {
        if (!IsFirstPage)
            CurrentPage--;
    }

    public class ADUserDto
    {
        public string SamAccountName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string DistinguishedName { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Enabled { get; set; }
    }
}